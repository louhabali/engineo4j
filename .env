MOVIE_DB_URI=postgres://localhost:5432/movie_db
RECOMMENDATION_DB_URI=your_postgres_uri_for_order_db
RATING_DB_URI=your_postgres_uri_for_product_db

REDIS_HOST=your_redis_host


